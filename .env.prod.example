# =============================================================================
# Production environment for the Lenovo server.
# Copy to `.env.prod` and set real values. NEVER commit `.env.prod`.
# =============================================================================

APP_NAME="Aegis Trader"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1
# CORS is only relevant to browser clients (the web terminal). Include every
# origin that will call the API from a browser.
CORS_ORIGINS=["https://traderbackend.awesometech.com.ng","https://trader.awesometech.com.ng"]

# --- Database (containerised) -----------------------------------------------
POSTGRES_USER=trader
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=trader

# Loopback port the backend is published on (proxied by the tunnel/nginx).
BACKEND_HOST_PORT=8899

# --- Auth / JWT --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_MIN_LENGTH=12

# --- Trading mode / LIVE TRADING PROTECTION ----------------------------------
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
BROKER_LIVE_CREDENTIALS_PRESENT=false
MANUAL_LIVE_ACTIVATION=false
PAPER_INITIAL_BALANCE=100000.00

# --- Broker / market data ----------------------------------------------------
BROKER_PROVIDER=paper
BROKER_PAPER_COMMISSION=0.00
BROKER_PAPER_SLIPPAGE_BPS=2.0
BROKER_PAPER_SPREAD_BPS=1.0
BROKER_PAPER_PARTIAL_FILLS=false
BROKER_PAPER_PARTIAL_FILL_RATIO=0.50
BROKER_PAPER_AUTO_CREATE_ACCOUNT=true
BROKER_PAPER_DEFAULT_CURRENCY=USD
PAPER_INITIAL_BALANCE=100000.00
PORTFOLIO_SNAPSHOT_INTERVAL_SECONDS=300
PORTFOLIO_HISTORY_MAX_POINTS=1000
WEBSOCKET_HEARTBEAT_SECONDS=30
MARKET_DATA_PROVIDER=mock
MARKET_DATA_STALE_SECONDS=60

# --- Market data cache + staleness (Phase 2) --------------------------------
MARKET_QUOTE_CACHE_TTL_SECONDS=5
MARKET_CANDLE_CACHE_TTL_SECONDS=60
MARKET_STATUS_CACHE_TTL_SECONDS=30
MAX_QUOTE_AGE_SECONDS=15
MAX_INTRADAY_CANDLE_AGE_SECONDS=300
MAX_DAILY_CANDLE_AGE_SECONDS=86400
MARKET_MAX_CANDLE_LIMIT=1000
MOCK_MARKET_SEED=42
MOCK_MARKET_SYMBOLS=AAPL,MSFT,NVDA,TSLA,AMZN,SPY
CSV_MARKET_DATA_PATH=

# --- Agent -------------------------------------------------------------------
AGENT_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=

# --- Risk (conservative examples, not financial advice) ---------------------
MAX_POSITION_PERCENTAGE=5.0
MAX_PORTFOLIO_EXPOSURE=80.0
MAX_OPEN_POSITIONS=10
MAX_DAILY_LOSS_PERCENTAGE=2.0
MAX_DRAWDOWN_PERCENTAGE=15.0
MAX_TRADES_PER_DAY=20
MINIMUM_CONFIDENCE=0.6
MINIMUM_RISK_REWARD_RATIO=2.0

# --- Cloudflare Tunnel (public exposure for traderbackend.awesometech.com.ng) --------
# Created in the Cloudflare Zero Trust dashboard. Only needed for the `tunnel`
# compose profile.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Web terminal (trader.awesometech.com.ng) -------------------------------
# Loopback port the web container is published on.
WEB_HOST_PORT=9077
# The browser calls the backend cross-origin; these are baked into the SPA at
# container start via Nuxt public runtime config.
NUXT_PUBLIC_API_BASE_URL=https://traderbackend.awesometech.com.ng
NUXT_PUBLIC_WS_BASE_URL=wss://traderbackend.awesometech.com.ng
