# Aegis Trader — Web frontend environment
# Copy to `.env` for local development. Values are exposed to the browser.

# Backend REST base URL (no trailing slash, no /api/v1 suffix).
NUXT_PUBLIC_API_BASE_URL=https://traderbackend.awesometech.com.ng

# Backend WebSocket base URL.
NUXT_PUBLIC_WS_BASE_URL=wss://traderbackend.awesometech.com.ng

# Set to true to serve isolated development mocks instead of the backend.
# NEVER enable this in production.
NUXT_PUBLIC_USE_MOCK_API=true
