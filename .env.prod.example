# =============================================================================
# Production environment for the Lenovo server.
# Copy to `.env.prod` and set real values. NEVER commit `.env.prod`.
# =============================================================================

APP_NAME="Aegis Trader"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1
# CORS is only relevant to browser clients (ReDoc / web). The mobile app is not
# subject to CORS.
CORS_ORIGINS=["https://rider.awesometech.com.ng"]

# --- Database (containerised) -----------------------------------------------
POSTGRES_USER=trader
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=trader

# Loopback port the backend is published on (proxied by the tunnel/nginx).
BACKEND_HOST_PORT=8899

# --- Auth / JWT --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_MIN_LENGTH=12

# --- Trading mode / LIVE TRADING PROTECTION ----------------------------------
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
BROKER_LIVE_CREDENTIALS_PRESENT=false
MANUAL_LIVE_ACTIVATION=false
PAPER_INITIAL_BALANCE=100000.00

# --- Broker / market data ----------------------------------------------------
BROKER_PROVIDER=paper
MARKET_DATA_PROVIDER=mock
MARKET_DATA_STALE_SECONDS=60

# --- Agent -------------------------------------------------------------------
AGENT_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=

# --- Risk (conservative examples, not financial advice) ---------------------
MAX_POSITION_PERCENTAGE=5.0
MAX_PORTFOLIO_EXPOSURE=80.0
MAX_OPEN_POSITIONS=10
MAX_DAILY_LOSS_PERCENTAGE=2.0
MAX_DRAWDOWN_PERCENTAGE=15.0
MAX_TRADES_PER_DAY=20
MINIMUM_CONFIDENCE=0.6
MINIMUM_RISK_REWARD_RATIO=2.0

# --- Cloudflare Tunnel (public exposure for rider.awesometech.com.ng) --------
# Created in the Cloudflare Zero Trust dashboard. Only needed for the `tunnel`
# compose profile.
CLOUDFLARE_TUNNEL_TOKEN=
