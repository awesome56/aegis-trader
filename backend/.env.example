# =============================================================================
# Aegis Trader - Backend configuration (EXAMPLE ONLY)
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="Aegis Trader"
ENVIRONMENT=development            # development|test|staging|production
DEBUG=true
LOG_LEVEL=INFO                     # DEBUG|INFO|WARNING|ERROR|CRITICAL
LOG_JSON=false                     # true in production for structured JSON logs
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://trader:trader@localhost:5432/trader
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_MIN_LENGTH=12

# --- Trading mode / LIVE TRADING PROTECTION ----------------------------------
# V1 MUST run in paper mode. Live trading requires ALL of the following:
#   TRADING_MODE=live
#   LIVE_TRADING_ENABLED=true
#   BROKER_LIVE_CREDENTIALS_PRESENT=true
#   MANUAL_LIVE_ACTIVATION=true
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
BROKER_LIVE_CREDENTIALS_PRESENT=false
MANUAL_LIVE_ACTIVATION=false

PAPER_INITIAL_BALANCE=100000.00

# --- Broker ------------------------------------------------------------------
BROKER_PROVIDER=paper              # paper|alpaca|ibkr|crypto (only paper in V1)
BROKER_PAPER_COMMISSION=0.00
BROKER_PAPER_SLIPPAGE_BPS=2.0
BROKER_PAPER_SPREAD_BPS=1.0
BROKER_PAPER_PARTIAL_FILLS=false
BROKER_PAPER_PARTIAL_FILL_RATIO=0.50
BROKER_PAPER_AUTO_CREATE_ACCOUNT=true
BROKER_PAPER_DEFAULT_CURRENCY=USD

# --- Market data -------------------------------------------------------------
MARKET_DATA_PROVIDER=mock          # mock|csv
MARKET_CACHE_PREFIX=market

# Cache TTLs (seconds)
MARKET_QUOTE_CACHE_TTL_SECONDS=5
MARKET_CANDLE_CACHE_TTL_SECONDS=60
MARKET_STATUS_CACHE_TTL_SECONDS=30

# Staleness thresholds (seconds) — compared against the MARKET timestamp.
MAX_QUOTE_AGE_SECONDS=15
MAX_INTRADAY_CANDLE_AGE_SECONDS=300
MAX_DAILY_CANDLE_AGE_SECONDS=86400

MARKET_MAX_CANDLE_LIMIT=1000
MARKET_DEFAULT_CURRENCY=USD

# Deterministic mock provider
MOCK_MARKET_SEED=42
MOCK_MARKET_SYMBOLS=AAPL,MSFT,NVDA,TSLA,AMZN,SPY
MOCK_MARKET_START_PRICE=100.0
MOCK_MARKET_VOLATILITY=0.02
MOCK_MARKET_IS_OPEN=true

# CSV provider (directory of {SYMBOL}_{timeframe}.csv files, or a single file
# with symbol+timeframe columns). Required columns: timestamp,open,high,low,close,volume
CSV_MARKET_DATA_PATH=
CSV_MARKET_DATA_IS_OPEN=true

# Superseded legacy aliases (kept for backward compatibility)
MARKET_DATA_STALE_SECONDS=60
MARKET_DATA_CACHE_TTL_SECONDS=5

# --- LLM / Agent -------------------------------------------------------------
LLM_PROVIDER=openai                # openai|anthropic|local
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0.0
AGENT_ENABLED=false

# --- Risk settings (CONSERVATIVE EXAMPLES - NOT FINANCIAL ADVICE) ------------
MAX_POSITION_PERCENTAGE=5.0
MAX_PORTFOLIO_EXPOSURE=80.0
MAX_OPEN_POSITIONS=10
MAX_DAILY_LOSS_PERCENTAGE=2.0
MAX_DRAWDOWN_PERCENTAGE=15.0
MAX_TRADES_PER_DAY=20
MINIMUM_CONFIDENCE=0.6
MINIMUM_RISK_REWARD_RATIO=2.0
MAX_SECTOR_EXPOSURE=30.0
MAX_ASSET_CLASS_EXPOSURE=60.0
REQUIRE_STOP_LOSS=true

# --- System ------------------------------------------------------------------
KILL_SWITCH_STATE=TRADING_ENABLED

# --- Strategies (Phase 5) ----------------------------------------------------
# Engineering defaults, not investment advice.
STRATEGY_AUTO_BOOTSTRAP=true
STRATEGY_DEFAULT_TIMEFRAME=1h
STRATEGY_SIGNAL_TTL_MULTIPLIER=2.0
STRATEGY_ANALYSIS_MAX_AGE_MULTIPLIER=3.0

STRATEGY_TREND_FAST_PERIOD=20
STRATEGY_TREND_SLOW_PERIOD=50
STRATEGY_TREND_ATR_PERIOD=14
STRATEGY_TREND_SLOPE_LOOKBACK=10
STRATEGY_TREND_MIN_MA_SPREAD_BPS=10.0
STRATEGY_TREND_MIN_CONFIDENCE=0.5
STRATEGY_TREND_ALLOW_HIGH_VOLATILITY=false

STRATEGY_MOMENTUM_RSI_PERIOD=14
STRATEGY_MOMENTUM_MACD_FAST_PERIOD=12
STRATEGY_MOMENTUM_MACD_SLOW_PERIOD=26
STRATEGY_MOMENTUM_MACD_SIGNAL_PERIOD=9
STRATEGY_MOMENTUM_VOLUME_PERIOD=20
STRATEGY_MOMENTUM_MIN_RELATIVE_VOLUME=1.0
STRATEGY_MOMENTUM_MIN_CONFIDENCE=0.5
STRATEGY_MOMENTUM_ALLOW_HIGH_VOLATILITY=false

STRATEGY_MEAN_REVERSION_BOLLINGER_PERIOD=20
STRATEGY_MEAN_REVERSION_BOLLINGER_STDDEV=2.0
STRATEGY_MEAN_REVERSION_PERCENT_B_LOW=0.05
STRATEGY_MEAN_REVERSION_PERCENT_B_HIGH=0.95
STRATEGY_MEAN_REVERSION_REQUIRE_CONFIRMATION=true
STRATEGY_MEAN_REVERSION_MIN_CONFIDENCE=0.5
STRATEGY_MEAN_REVERSION_ALLOW_TRENDING=false
STRATEGY_RSI_OVERSOLD=30
STRATEGY_RSI_OVERBOUGHT=70

# --- Market regime (Phase 5) -------------------------------------------------
REGIME_FAST_PERIOD=20
REGIME_SLOW_PERIOD=50
REGIME_ATR_PERIOD=14
REGIME_SLOPE_LOOKBACK=10
REGIME_TREND_MIN_SPREAD_BPS=10.0
REGIME_HIGH_VOLATILITY_ATR_PERCENT=3.0
REGIME_LOW_VOLATILITY_ATR_PERCENT=1.0

# --- Risk engine (Phase 6) ---------------------------------------------------
# MAX_POSITION_PERCENTAGE / MAX_PORTFOLIO_EXPOSURE / MAX_OPEN_POSITIONS /
# MAX_DAILY_LOSS_PERCENTAGE / MAX_DRAWDOWN_PERCENTAGE / MAX_TRADES_PER_DAY /
# MINIMUM_CONFIDENCE / MINIMUM_RISK_REWARD_RATIO / MAX_SECTOR_EXPOSURE /
# MAX_ASSET_CLASS_EXPOSURE / REQUIRE_STOP_LOSS are declared above.
RISK_ENABLED=true
RISK_MAX_RISK_PER_TRADE_PERCENT=1.0
RISK_REQUIRE_STRATEGY_SIGNAL=false
RISK_UNKNOWN_SECTOR_POLICY=warn
RISK_DAILY_LOSS_INCLUDE_UNREALIZED=true
RISK_COMMISSION_BUFFER_BPS=5.0
RISK_WARNING_UTILIZATION_PERCENT=80.0
RISK_CRITICAL_UTILIZATION_PERCENT=100.0
RISK_DEFAULT_TRADING_STATE=TRADING_ENABLED

# --- Trade proposals / execution (Phase 7) -----------------------------------
# Time a proposal stays executable before it expires.
TRADE_PROPOSAL_TTL_SECONDS=300
# Reject execution if the live price deviates more than this from the proposal.
EXECUTION_MAX_PRICE_DEVIATION_BPS=50.0
# Re-run the Risk Engine immediately before submitting to the broker.
EXECUTION_REQUIRE_FINAL_RISK_REVALIDATION=true

# --- Background worker (Phase 7) ---------------------------------------------
WORKER_ENABLED=true
WORKER_OPEN_ORDER_INTERVAL_SECONDS=10
WORKER_PORTFOLIO_SNAPSHOT_INTERVAL_SECONDS=300
WORKER_STRATEGY_EVALUATION_INTERVAL_SECONDS=60
# Distributed lock TTL for worker jobs (also heartbeat TTL base).
WORKER_LOCK_TTL_SECONDS=60
# Comma-separated symbols for strategy evaluation; empty = mock universe.
WORKER_STRATEGY_SYMBOLS=

# --- Deterministic strategy scenarios (development / validation) -------------
# Empty = default pseudo-random mock walk. Set one of:
# uptrend | downtrend | momentum_bullish | momentum_bearish |
# mean_reversion_oversold | mean_reversion_overbought | sideways | high_volatility
# Then run: python -m scripts.seed_strategy_signals --scenario <name>
MOCK_MARKET_SCENARIO=

# --- Backtesting (Phase 8) ---------------------------------------------------
BACKTEST_ENABLED=true
BACKTEST_MAX_CONCURRENT_PER_USER=2
BACKTEST_MAX_CANDLES=5000
BACKTEST_MAX_RANGE_DAYS=3650
BACKTEST_DEFAULT_INITIAL_CAPITAL=100000
BACKTEST_DEFAULT_POSITION_PERCENT=100
BACKTEST_DEFAULT_COMMISSION_PCT=0
BACKTEST_DEFAULT_SLIPPAGE_PCT=0
BACKTEST_FORCE_CLOSE_AT_END=true

# --- AI providers / TradingAnalysisAgent (Phase 9) --------------------------
AI_ENABLED=true
# urlsafe base64 32-byte Fernet key (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Required to store/read provider API tokens. Back this up; losing it makes stored
# credentials undecryptable (they must be re-entered).
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_ALLOW_CUSTOM_BASE_URL=true
AI_ALLOW_PRIVATE_BASE_URL=false
AI_ALLOW_HTTP_BASE_URL=false
AI_HTTP_TIMEOUT_SECONDS=30
AGENT_DEFAULT_MODE=ANALYSIS_ONLY
AGENT_MAX_TOOL_ITERATIONS=8
AGENT_RUN_TIMEOUT_SECONDS=60
AGENT_MAX_CONCURRENT_RUNS_PER_USER=2
AGENT_MAX_RUNS_PER_MINUTE=10
AGENT_MAX_OUTPUT_TOKENS=1500
AGENT_TEMPERATURE=0

# --- Real market data (Phase 10A) -------------------------------------------
# Active symbol universe for real providers (empty = MOCK_MARKET_SYMBOLS).
# Examples: AAPL,MSFT,SPY,EUR/USD,BTC/USD
MARKET_SYMBOLS=
MARKET_HTTP_TIMEOUT_SECONDS=15
# Twelve Data covers equities + forex + crypto with one key.
# Set MARKET_DATA_PROVIDER=twelvedata and provide the key.
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
# Kraken public crypto data (keyless, no KYC). Set MARKET_DATA_PROVIDER=kraken.
KRAKEN_BASE_URL=https://api.kraken.com
